# TMDB importer configuration (§12.4, §14). Copy to .env and fill in the token.
# The .env file is git-ignored; never commit a real token.

# Required to seed: a TMDB v4 Read Access Token.
# Create one at https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# TMDB API + image CDN (defaults are fine).
TMDB_API_BASE=https://api.themoviedb.org
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
TMDB_POSTER_SIZE=w500
TMDB_PROFILE_SIZE=w185

# Application interfaces the importer targets (Compose service names by default).
CATALOGUE_GRAPHQL_URL=http://catalogue-service:8080/graphql
CATALOGUE_HTTP_URL=http://catalogue-service:8080
PEOPLE_HTTP_URL=http://people-service:8081
PEOPLE_GRPC_TARGET=people-service:9090

# Import tuning.
IMPORT_CONCURRENCY=4
IMPORT_REQUEST_TIMEOUT_MS=10000
IMPORT_MAX_RETRIES=5

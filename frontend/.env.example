# SvelteKit BFF server-side configuration. These are read server-side only.
# Catalogue GraphQL endpoint (server-to-server; never exposed to the browser).
CATALOGUE_GRAPHQL_URL=http://localhost:8080/graphql
# Catalogue HTTP base for artwork media relay.
CATALOGUE_HTTP_URL=http://localhost:8080
# People HTTP base for person-photo relay (internal network).
PEOPLE_HTTP_URL=http://localhost:8081

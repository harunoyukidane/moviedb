# Keep the Docker build context small. The runtime images copy the host-built
# boot jar from build/libs, so exclude the rest of build/ but re-include the jars.
**/build/
!**/build/libs/
!**/build/libs/*.jar
**/.gradle/
**/.idea/
**/*.iml
frontend/node_modules/
frontend/.svelte-kit/
.git/
*.md
!settings.gradle.kts

# Copy this file to .env and fill in values. .env is git-ignored.
# No real secrets belong in this example file.

# --- Catalogue database ---
CATALOGUE_DB_NAME=catalogue
CATALOGUE_DB_USER=catalogue
CATALOGUE_DB_PASSWORD=change-me-catalogue

# --- People database ---
PEOPLE_DB_NAME=people
PEOPLE_DB_USER=people
PEOPLE_DB_PASSWORD=change-me-people

# --- Service wiring (used by compose) ---
# Catalogue reaches People over gRPC on the internal compose network.
PEOPLE_GRPC_TARGET=people-service:9090

# --- Published host ports (reviewer-facing) ---
CATALOGUE_HTTP_PORT=8080
FRONTEND_PORT=4173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Object storage (MinIO, ADR-14). compose.yaml runs both services against MinIO
# by default; set ARTWORK_STORAGE_TYPE=local only to intentionally opt a service back
# out for isolated local runs. Never a shared credential between services:
# least-privilege, one identity per bucket, provisioned by the one-shot minio-init
# service (scripts/minio-provision.sh).
ARTWORK_STORAGE_TYPE=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
# Bootstrap-only root credentials for minio-init; never given to either application.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root
CATALOGUE_MINIO_ACCESS_KEY=change-me-catalogue-key
CATALOGUE_MINIO_SECRET_KEY=change-me-catalogue-secret
PEOPLE_MINIO_ACCESS_KEY=change-me-people-key
PEOPLE_MINIO_SECRET_KEY=change-me-people-secret

# --- TMDB demo import (phase 7). Leave blank to start an empty app. ---
# Create a v4 Read Access Token at https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
TMDB_POSTER_SIZE=w500
